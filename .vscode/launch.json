{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Active C File",
            "type": "cppdbg",
            "request": "launch",
            // Dynamically targets the binary created by the task above
            "program": "${fileDirname}/${fileBasenameNoExtension}", // Add .exe if on Windows
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb", // Adjust path to your GDB installation
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build Active C File" // Must match the task label exactly
        }
    ]
}