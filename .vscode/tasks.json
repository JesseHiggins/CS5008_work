{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Active C File",
            "command": "/usr/bin/gcc", // Adjust if using MinGW/clang
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}", // Compiles the file currently active in your editor
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}" // Outputs binary matching the file name (add .exe if on Windows)
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}